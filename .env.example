ANTHROPIC_API_KEY=

# Model used for reviews. Options (cheapest → strongest):
#   claude-haiku-5-5   ~$0.003–0.02 per review
#   claude-sonnet-5-5  ~$0.05–0.30 per review
#   claude-opus-5-5    ~$0.10–0.60 per review (default)
CLAUDE_MODEL=claude-opus-5-5

# How hard the model thinks: low | medium | high | xhigh | max
# Lower = cheaper and faster, higher = more thorough.
CLAUDE_EFFORT=high
